   218|</div>
   219|
   220|</main>
   221|<footer class="footer">Hecho con ❤️ por David Antizar</footer>
   222|<script>
   223|function checkAnswer(btn, correct) {
   224|  var parent = btn.parentElement;
   225|  parent.querySelectorAll('button').forEach(function(b) {
   226|    b.disabled = true; b.classList.remove('correct','wrong');
   227|  });
   228|  btn.classList.add(correct ? 'correct' : 'wrong');
   229|  var feedback = parent.nextElementSibling;
   230|  if(feedback && feedback.classList.contains('feedback')) {
   231|    if(correct) {
   232|      feedback.textContent = '✅ ¡Correcto! ¡Muy bien!';
   233|      feedback.className = 'feedback correct';
   234|    } else {
   235|      feedback.textContent = '❌ ¡Intenta de nuevo!';
   236|      feedback.className = 'feedback incorrect';
   237|      setTimeout(function() {
   238|        parent.querySelectorAll('button').forEach(function(b) {
   239|          b.disabled = false; b.classList.remove('correct','wrong');
   240|        });
   241|        feedback.textContent = '';
   242|        feedback.className = 'feedback';
   243|      }, 1500);
   244|    }
   245|  }
   246|}
   247|
   248|function checkExercise(id, correct, btn) {
   249|  var input = document.getElementById(id);
   250|  var feedback = input.parentElement.nextElementSibling;
   251|  var userVal = input.value.trim().replace(',', '.');
   252|  var correctVal = correct.toString().replace(',', '.');
   253|  if(userVal === correctVal) {
   254|    feedback.textContent = '✅ ¡Correcto! ' + correct;
   255|    feedback.className = 'feedback correct';
   256|    input.style.borderColor = 'var(--verde)';
   257|  } else {
   258|    feedback.textContent = '❌ Respuesta correcta: ' + correct;
   259|    feedback.className = 'feedback incorrect';
   260|    input.style.borderColor = 'var(--rojo)';
   261|  }
   262|}
   263|
   264|window.onscroll = function(){
   265|  var h = document.documentElement;
   266|  var p = (window.scrollY/(h.scrollHeight-h.clientHeight))*100;
   267|  document.getElementById('progress').style.width = p+'%';
   268|};
   269|</script>
   270|</body>
