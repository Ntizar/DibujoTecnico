   225|<a href="b03-05-perspectivas-piezas.html">Siguiente →</a>
   226|</div>
   227|
   228|</main>
   229|<footer class="footer">Hecho con ❤️ por David Antizar</footer>
   230|<script>
   231|function checkAnswer(btn, correct) {
   232|  var parent = btn.parentElement;
   233|  parent.querySelectorAll('button').forEach(function(b) {
   234|    b.disabled = true; b.classList.remove('correct','wrong');
   235|  });
   236|  btn.classList.add(correct ? 'correct' : 'wrong');
   237|  var feedback = parent.nextElementSibling;
   238|  if(feedback && feedback.classList.contains('feedback')) {
   239|    if(correct) {
   240|      feedback.textContent = '✅ ¡Correcto! ¡Muy bien!';
   241|      feedback.className = 'feedback correct';
   242|    } else {
   243|      feedback.textContent = '❌ ¡Intenta de nuevo!';
   244|      feedback.className = 'feedback incorrect';
   245|      setTimeout(function() {
   246|        parent.querySelectorAll('button').forEach(function(b) {
   247|          b.disabled = false; b.classList.remove('correct','wrong');
   248|        });
   249|        feedback.textContent = '';
   250|        feedback.className = 'feedback';
   251|      }, 1500);
   252|    }
   253|  }
   254|}
   255|
   256|function checkExercise(id, correct, btn) {
   257|  var input = document.getElementById(id);
   258|  var feedback = input.parentElement.nextElementSibling;
   259|  var userVal = input.value.trim().replace(',', '.');
   260|  var correctVal = correct.toString().replace(',', '.');
   261|  if(userVal === correctVal) {
   262|    feedback.textContent = '✅ ¡Correcto! ' + correct;
   263|    feedback.className = 'feedback correct';
   264|    input.style.borderColor = 'var(--verde)';
   265|  } else {
   266|    feedback.textContent = '❌ Respuesta correcta: ' + correct;
   267|    feedback.className = 'feedback incorrect';
   268|    input.style.borderColor = 'var(--rojo)';
   269|  }
   270|}
   271|
   272|window.onscroll = function(){
   273|  var h = document.documentElement;
   274|  var p = (window.scrollY/(h.scrollHeight-h.clientHeight))*100;
   275|  document.getElementById('progress').style.width = p+'%';
   276|};
   277|</script>
